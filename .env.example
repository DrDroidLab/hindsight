# Normal deployment: required; use a dedicated, sanitized, writable knowledge remote.
# No credentials in this URL. The offline compose.demo.yaml overrides it.
GIT_REMOTE=ssh://git@git.example.invalid/your-team/knowledge.git
GIT_BRANCH=main
HINDSIGHT_PORT=8080
# Pin a release instead of :latest, e.g. ghcr.io/drdroidlab/hindsight:0.1.0
# HINDSIGHT_IMAGE=ghcr.io/drdroidlab/hindsight:latest
SYNC_INTERVAL=60
STALE_AFTER_DAYS=90
READ_ONLY=false
REVIEW_MODE=local
# In git mode, captures are committed here for normal external git review.
PROPOSAL_BRANCH=hindsight/proposals
# Add your exact proxy hostname and HTTPS origin before remote exposure.
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=
# Required behind TLS termination: canonical external HTTPS origin (no path).
PUBLIC_ORIGIN=
# Optional extraction: no provider is contacted unless explicitly configured.
LLM_ENDPOINT=
LLM_MODEL=
LLM_KEY=
# Optional semantic ranking; ordinary FTS retrieval needs no model.
EMBEDDINGS_ENDPOINT=
EMBEDDINGS_MODEL=
EMBEDDINGS_KEY=
# Container path to an operator-mounted rules file; see docs/security.md.
REDACTION_RULES=
# GIT_AUTH is documentation shorthand for mounted SSH credentials or a supported
# credential helper, not a portable token environment variable.
